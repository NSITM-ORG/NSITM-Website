# ── SERVER
NODE_ENV=development
PORT=5000

# ── DATABASE (MongoDB Compass — local)
MONGO_URI=mongodb://localhost:27017/nsitm_dev

# ── JWT
JWT_SECRET=nsitm_dev_jwt_secret_replace_with_strong_value
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=nsitm_dev_refresh_secret_replace_with_strong_value
JWT_REFRESH_EXPIRES_IN=7d

# ── TOKEN EXPIRY (milliseconds)
PASSWORD_RESET_TOKEN_EXPIRY_MS=3600000
INSTALMENT_TOKEN_EXPIRY_MS=1800000

# ── CORS ORIGINS
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000

# ── EMAIL (Resend)
# Leave blank in development — emails will be mocked/logged to console
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ── FILE UPLOAD (Cloudinary)
# Set to false in development — uploads will use mock placeholders
UPLOAD_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SIGNED URL EXPIRY (Cloudinary authenticated receipt viewing) ──────
# How long a generated receipt view link stays valid after an admin
# opens a record. Not security-critical (the admin is already
# authenticated); this just bounds how long a link stays "hot" if
# copy-pasted elsewhere.
RECEIPT_SIGNED_URL_EXPIRY_SECONDS=3600