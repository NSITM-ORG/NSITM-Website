# ═══════════════════════════════════════════════════════════════════
# NSITM BACKEND — DEVELOPMENT ENVIRONMENT
# Loaded automatically when NODE_ENV=development (npm run dev).
# Values here are safe local-only defaults — this file is gitignored,
# but nothing here needs to be a "real" secret since it never leaves
# your machine.
# ═══════════════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── DATABASE ───────────────────────────────────────────────────────
# Local MongoDB — connect with MongoDB Compass at this same URI to
# inspect data visually while developing.
MONGO_URI=mongodb://localhost:27017/nsitm_dev

# ── JWT AUTHENTICATION ─────────────────────────────────────────────
# These are throwaway dev secrets — fine to use as-is locally, but
# NEVER reuse these values in production. Both are already 64+ chars.
JWT_SECRET=nsitm_dev_jwt_secret_replace_with_a_long_random_value_before_prod
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=nsitm_dev_refresh_secret_replace_with_a_long_random_value_too
JWT_REFRESH_EXPIRES_IN=7d

# ── TOKEN EXPIRY (milliseconds) ────────────────────────────────────
# PASSWORD_RESET_TOKEN_EXPIRY_MS is unused (see .env.example note) —
# kept for backward compatibility only.
PASSWORD_RESET_TOKEN_EXPIRY_MS=3600000
INSTALMENT_TOKEN_EXPIRY_MS=1800000

# ── CORS / FRONTEND ORIGINS ────────────────────────────────────────
# Matches Vite's default dev server port (5173).
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# ── EMAIL (Resend) ─────────────────────────────────────────────────
# Intentionally blank — every email (NTF-01 through NTF-12) will print
# in full to your terminal running `npm run dev` instead of sending.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ── FILE UPLOAD (Cloudinary) ───────────────────────────────────────
# Disabled locally — receipt uploads accept any valid file but store a
# mock placeholder ({"provider":"local"}) instead of hitting Cloudinary.
# The full enrollment/instalment flow works end-to-end without this.
UPLOAD_ENABLED=true
CLOUDINARY_CLOUD_NAME=<FILL_IN>
CLOUDINARY_API_KEY=<FILL_IN>
CLOUDINARY_API_SECRET=<FILL_IN>
RECEIPT_SIGNED_URL_EXPIRY_SECONDS=3600

# ── SUPER ADMIN SETUP KEY ──────────────────────────────────────────
# Only enforced/validated in production at boot — safe to leave a
# simple local value here for testing POST /superadmin/auth/register.
SUPER_ADMIN_SETUP_KEY=dev_setup_key_change_this_before_any_real_deployment

# ── SEED SCRIPT ─────────────────────────────────────────────────────
# Used by: npm run seed:superadmin
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=


Resend API Key: 

Resend Email: 