# ═══════════════════════════════════════════════════════════════════
# NSITM BACKEND — ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to .env.development or .env.production and fill in
# real values. This file itself is committed to version control and
# must NEVER contain real secrets — only placeholders and structure.
# ═══════════════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── DATABASE ───────────────────────────────────────────────────────
# Development: MongoDB Compass / local mongod instance
# Production:  MongoDB Atlas connection string
MONGO_URI=

# ── JWT AUTHENTICATION ─────────────────────────────────────────────
# Both secrets MUST be at least 32 characters (enforced at boot by
# validateEnv.js — a short secret throws in production, warns in dev).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── TOKEN EXPIRY (milliseconds) ────────────────────────────────────
# NOTE: PASSWORD_RESET_TOKEN_EXPIRY_MS is intentionally UNUSED as of
# the auth overhaul — password reset tokens no longer time-expire
# (they live until used or superseded by a newer request, per the
# client's explicit "links stay valid until invalidated" decision).
# Left here only so nothing breaks if any code still references it.
PASSWORD_RESET_TOKEN_EXPIRY_MS=3600000
INSTALMENT_TOKEN_EXPIRY_MS=1800000

# ── CORS / FRONTEND ORIGINS ────────────────────────────────────────
# Must match the frontend's ACTUAL deployed origin exactly, including
# protocol. This is what the CORS allowlist AND the session cookie's
# sameSite:'none' (production) / 'lax' (development) logic depend on.
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# ── EMAIL (Resend) ─────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in development — all 12 email templates
# will be logged to the server console in full instead of sent.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ── FILE UPLOAD (Cloudinary) ───────────────────────────────────────
# UPLOAD_ENABLED=false in development — uploads use a mock placeholder,
# no Cloudinary account needed to test the full enrollment flow locally.
# MUST be true in production.
UPLOAD_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# How long a generated receipt-viewing signed URL stays valid after an
# admin opens a record (Cloudinary authenticated-resource delivery).
RECEIPT_SIGNED_URL_EXPIRY_SECONDS=3600

# ── SUPER ADMIN SETUP KEY ──────────────────────────────────────────
# Guards POST /superadmin/auth/register — the ONLY way a Super Admin
# account can self-register. Anyone holding this key can create a
# Super Admin account. REQUIRED in production — server refuses to boot
# without it (see src/config/validateEnv.js). Generate the same way as
# JWT_SECRET above. Rotate or remove access to this value once your
# one legitimate Super Admin account has been created.
SUPER_ADMIN_SETUP_KEY=

# ── SEED SCRIPT (scripts/seedSuperAdmin.js — alternative bootstrap
# path to the setup-key route above; use ONE method, not both) ──────
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=