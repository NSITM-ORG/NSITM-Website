# ═══════════════════════════════════════════════════════════════════
# NSITM BACKEND — PRODUCTION ENVIRONMENT
# Loaded automatically when NODE_ENV=production. EVERY value below
# marked <FILL_IN> is validated at boot (src/config/validateEnv.js) —
# the server will refuse to start if any REQUIRED_ALWAYS or
# REQUIRED_PRODUCTION_ONLY variable is missing, and will refuse to
# start if JWT_SECRET/JWT_REFRESH_SECRET are under 32 characters.
# ═══════════════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── DATABASE ───────────────────────────────────────────────────────
# MongoDB Atlas connection string — get this from your Atlas cluster's
# "Connect" dialog. Replace <USERNAME>, <PASSWORD>, <CLUSTER>.
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority

# ── JWT AUTHENTICATION ─────────────────────────────────────────────
# REQUIRED. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be genuinely random, at least 32 chars, and DIFFERENT from each
# other and from anything used in development.
JWT_SECRET=<FILL_IN_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=<FILL_IN_DIFFERENT_LONG_RANDOM_SECRET>
JWT_REFRESH_EXPIRES_IN=7d

# ── TOKEN EXPIRY (milliseconds) ────────────────────────────────────
# PASSWORD_RESET_TOKEN_EXPIRY_MS is unused in current logic — kept for
# backward compatibility, no action needed.
PASSWORD_RESET_TOKEN_EXPIRY_MS=3600000
INSTALMENT_TOKEN_EXPIRY_MS=1800000

# ── CORS / FRONTEND ORIGINS ────────────────────────────────────────
# MUST exactly match your deployed frontend's real URL, protocol
# included. A mismatch here breaks login silently — the cookie will
# appear to be set but never actually get sent on subsequent requests,
# because CORS + sameSite:'none' both depend on this being exact.
CLIENT_URL=https://<YOUR_FRONTEND_DOMAIN>
ADMIN_URL=https://<YOUR_FRONTEND_DOMAIN>

# ── EMAIL (Resend) ─────────────────────────────────────────────────
# REQUIRED in production. Get your API key from resend.com/api-keys.
# EMAIL_FROM must be a domain you've verified in Resend.
RESEND_API_KEY=<FILL_IN_RESEND_API_KEY>
EMAIL_FROM=noreply@<YOUR_VERIFIED_DOMAIN>

# ── FILE UPLOAD (Cloudinary) ───────────────────────────────────────
# REQUIRED in production. Get all three from your Cloudinary dashboard.
UPLOAD_ENABLED=true
CLOUDINARY_CLOUD_NAME=<FILL_IN>
CLOUDINARY_API_KEY=<FILL_IN>
CLOUDINARY_API_SECRET=<FILL_IN>
RECEIPT_SIGNED_URL_EXPIRY_SECONDS=3600

# ── SUPER ADMIN SETUP KEY ──────────────────────────────────────────
# REQUIRED. Generate the same way as JWT_SECRET above. This key alone
# grants Super Admin account creation via POST /superadmin/auth/register
# — treat it exactly like a master password. Once your one legitimate
# Super Admin account exists, consider rotating this value (or removing
# public knowledge of it) so the self-registration route can't be used
# again by anyone who obtained the original key.
SUPER_ADMIN_SETUP_KEY=<FILL_IN_LONG_RANDOM_SECRET>

# ── SEED SCRIPT (alternative to the setup-key route above) ─────────
# Only needed if you plan to run `npm run seed:superadmin` instead of
# using the /register endpoint. Leave blank if you're using the route.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=