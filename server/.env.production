# ── SERVER
NODE_ENV=production
PORT=5000

# ── DATABASE (MongoDB Atlas)
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/nsitm_prod?retryWrites=true&w=majority

# ── JWT
JWT_SECRET=<STRONG_RANDOM_SECRET_MIN_64_CHARS>
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=<STRONG_RANDOM_REFRESH_SECRET_MIN_64_CHARS>
JWT_REFRESH_EXPIRES_IN=7d

# ── TOKEN EXPIRY (milliseconds)
PASSWORD_RESET_TOKEN_EXPIRY_MS=3600000
INSTALMENT_TOKEN_EXPIRY_MS=1800000

# ── CORS ORIGINS
CLIENT_URL=https://nsitm.com.ng
ADMIN_URL=https://admin.nsitm.com.ng

# ── EMAIL (Resend)
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
EMAIL_FROM=noreply@nsitm.com.ng

# ── FILE UPLOAD (Cloudinary)
# MUST be true in production — real file uploads required
UPLOAD_ENABLED=true
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_API_SECRET>