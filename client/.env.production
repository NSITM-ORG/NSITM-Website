# ═══════════════════════════════════════════════════════════════════
# NSITM FRONTEND — PRODUCTION ENVIRONMENT
# Loaded automatically by `npm run build`. Both URLs below MUST match
# their real deployed counterparts exactly — a mismatch here is the
# single most common cause of "login works but every request after it
# 401s" in production (see backend .env.production's CORS note — the
# two files' URLs must agree with each other).
# ═══════════════════════════════════════════════════════════════════

VITE_API_BASE_URL=https://<YOUR_BACKEND_DOMAIN>/api/v1
VITE_APP_ENV=production
VITE_APP_NAME=Nextserve
VITE_CLIENT_URL=https://<YOUR_FRONTEND_DOMAIN>