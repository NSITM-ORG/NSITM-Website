# ═══════════════════════════════════════════════════════════════════
# NSITM FRONTEND — ENVIRONMENT VARIABLE TEMPLATE
# Vite requires every variable exposed to client-side code to be
# prefixed with VITE_ — anything without that prefix is invisible to
# import.meta.env and silently unavailable in the browser bundle.
# Copy this file to .env.development or .env.production.
# ═══════════════════════════════════════════════════════════════════

# Full base URL of the backend API, including the /api/v1 prefix.
VITE_API_BASE_URL=

# 'development' | 'production' — read by a couple of components
# (e.g. Redux DevTools gating in store.js) to branch behavior.
VITE_APP_ENV=

# Displayed in <title> tags, the SEO fallback, and the Preloader.
VITE_APP_NAME=Nextserve

# The frontend's own deployed origin — reserved for any future
# absolute-URL need (e.g. Open Graph image tags requiring a full URL
# rather than a relative path). Not consumed by any critical path today.
VITE_CLIENT_URL=